# Copy to .env (gitignored) at the paid-media-analyst-skills root, or set these in your environment.
# Never commit real keys.

# Firecrawl hosted scraper: used by scripts/firecrawl_fetch.py and the firecrawl-scrape /
# landing-page-audit skills when WebFetch is blocked. Allow egress to api.firecrawl.dev.
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# TypeSafe System One (Jev): optional judgment layer used by scripts/jev_judge.py and
# scripts/lp_judgments.py. Allow egress to api.typesafe.ai. Skills skip the layer when unset.
TYPESAFE_API_KEY=your_typesafe_api_key_here
